// Схема базы данных Prisma.
//
// Prisma 7: генератор называется prisma-client (Rust-free движок), а поле output
// обязательно — клиент больше не создаётся в node_modules, а генерируется
// в указанную папку. Импортировать его нужно из «.../client».

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// В Prisma 7 строка подключения больше не указывается здесь:
// она задаётся в prisma.config.ts, чтобы схема не зависела от окружения.
datasource db {
  provider = "postgresql"
}

/// Роль пользователя. Enum проверяется на уровне базы, а не только в коде.
enum Role {
  ADMIN
  EDITOR
}

/// Администратор сайта. Пароль хранится только в виде хеша.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts    Post[]
  projects Project[]

  @@map("users")
}

/// Проект в портфолио.
model Project {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  summary    String
  content    String
  coverImage String?

  repoUrl String?
  liveUrl String?

  /// Массив строк — нативная возможность PostgreSQL.
  techStack String[]

  featured  Boolean @default(false)
  /// Ручная сортировка в списке проектов.
  position  Int     @default(0)
  published Boolean @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Составной индекс под запрос «опубликованные, в нужном порядке».
  @@index([published, position])
  @@map("projects")
}

/// Статья в блоге.
model Post {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  excerpt    String
  content    String
  coverImage String?

  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  readingTime Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Связь многие-ко-многим. Prisma сама создаст таблицу-связку _PostToTag.
  tags Tag[]

  @@index([published, publishedAt])
  @@map("posts")
}

/// Тег статьи.
model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  posts Post[]

  @@map("tags")
}

/// Сообщение из формы обратной связи.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("contact_messages")
}

/// Настройки сайта в формате ключ-значение: текст «Обо мне», соцсети и т.п.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
